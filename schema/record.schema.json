{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Editorial record (record.yml), maintained by the maintainer and the bot",
  "type": "object",
  "required": ["id", "status", "submitted", "accepted", "versions"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^\\d{4}-\\d{4}$"},
    "status": {"enum": ["published", "withdrawn"]},
    "submitted": {"type": "string", "format": "date"},
    "accepted": {"type": "string", "format": "date"},
    "issue": {"type": ["integer", "null"]},
    "concept_doi": {"type": ["string", "null"]},
    "zenodo_concept_id": {"type": ["integer", "null"]},
    "withdrawn": {
      "type": "object",
      "required": ["date", "reason"],
      "additionalProperties": false,
      "properties": {"date": {"type": "string", "format": "date"}, "reason": {"type": "string"}}
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["version", "published"],
        "additionalProperties": false,
        "properties": {
          "version": {"type": "integer", "minimum": 1},
          "published": {"type": "string", "format": "date"},
          "doi": {"type": ["string", "null"]},
          "zenodo_id": {"type": ["integer", "null"]},
          "changelog": {"type": "string"}
        }
      }
    }
  }
}
