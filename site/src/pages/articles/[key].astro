---
import Base from "../../layouts/Base.astro";
import ArticleView from "../../components/ArticleView.astro";
import ScholarMeta from "../../components/ScholarMeta.astro";
import { articles, latest, type Article, type Version } from "../../lib/data";

export function getStaticPaths() {
  return articles.flatMap((article) => [
    { params: { key: article.id }, props: { article, version: latest(article), canonical: true } },
    ...article.versions.map((version) => ({ params: { key: `${article.id}v${version.version}` }, props: { article, version, canonical: false } })),
  ]);
}

interface Props {
  article: Article;
  version: Version;
  canonical: boolean;
}
const { article, version, canonical } = Astro.props;
const title = version.translation?.title ?? version.title;
const plain = (version.abstract_html ?? "").replace(/<[^>]+>/g, "").slice(0, 300);
---
<Base title={title} description={plain} current="articles">
  {article.status === "published" && <ScholarMeta slot="head" article={article} version={version} />}
  <ArticleView article={article} version={version} searchable={canonical && article.status === "published"} />
</Base>
